---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORY_LIST } from '../../consts';
import { contaPerCategoria } from '../../lib/articoli';
import { withBase } from '../../lib/url';

const conteggi = await contaPerCategoria();
---

<BaseLayout
	title="Categorie"
	description="Esplora il blog per argomento: Serie A, coppe europee, nazionali, tattica, calciomercato e storie di calcio."
>
	<div class="container">
		<header class="page-head">
			<p class="kicker">Argomenti</p>
			<h1>Categorie</h1>
			<p class="lead">Ogni categoria raccoglie gli articoli su un tema. Scegli da dove iniziare.</p>
		</header>

		<ul class="categorie">
			{
				CATEGORY_LIST.map((categoria) => (
					<li>
						<a href={withBase(`/categorie/${categoria.id}/`)}>
							<span class="emoji" aria-hidden="true">{categoria.emoji}</span>
							<h2>{categoria.label}</h2>
							<p class="descrizione">{categoria.description}</p>
							<span class="conteggio">
								{conteggi[categoria.id]} {conteggi[categoria.id] === 1 ? 'articolo' : 'articoli'}
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>

<style>
	.page-head {
		max-width: var(--prose);
		margin-bottom: 3rem;
	}

	.kicker {
		margin-bottom: 0.75rem;
		color: var(--brand);
		font-family: var(--font-display);
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.lead {
		margin-top: 1rem;
		color: var(--text-soft);
		font-size: 1.1rem;
	}

	.categorie {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.25rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.categorie a {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		height: 100%;
		padding: 1.75rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		transition: border-color 0.15s ease, background 0.15s ease, transform 0.18s ease;
	}

	.categorie a:hover {
		transform: translateY(-3px);
		border-color: var(--brand);
		background: var(--surface-hover);
	}

	.emoji {
		font-size: 2rem;
		line-height: 1;
	}

	h2 {
		font-size: 1.6rem;
	}

	.descrizione {
		color: var(--text-soft);
		font-size: 0.95rem;
	}

	.conteggio {
		margin-top: auto;
		padding-top: 0.75rem;
		color: var(--brand);
		font-size: 0.85rem;
		font-weight: 600;
	}
</style>
