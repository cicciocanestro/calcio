---
import type { Articolo } from '../lib/articoli';
import { formattaDataBreve, tempoDiLettura } from '../lib/articoli';
import { categoryOf } from '../consts';
import { withBase } from '../lib/url';

interface Props {
	articolo: Articolo;
	variant?: 'default' | 'feature';
}

const { articolo, variant = 'default' } = Astro.props;
const { title, description, pubDate, category, cover, coverAlt } = articolo.data;
const categoria = categoryOf(category);
const href = withBase(`/articoli/${articolo.id}/`);
---

<article class:list={['card', { feature: variant === 'feature' }]}>
	{
		cover ? (
			<img class="card-cover" src={withBase(cover)} alt={coverAlt ?? ''} loading="lazy" />
		) : (
			<div class="card-strip" aria-hidden="true">
				<span>{categoria.emoji}</span>
			</div>
		)
	}

	<div class="card-body">
		<a class="badge" href={withBase(`/categorie/${categoria.id}/`)}>
			<span aria-hidden="true">{categoria.emoji}</span>
			{categoria.label}
		</a>

		<h3 class="card-title">
			<a href={href}>{title}</a>
		</h3>

		<p class="card-desc">{description}</p>

		<p class="card-meta">
			<time datetime={pubDate.toISOString()}>{formattaDataBreve(pubDate)}</time>
			<span class="dot">{tempoDiLettura(articolo.body)}</span>
		</p>
	</div>
</article>

<style>
	.card-strip {
		display: grid;
		place-items: center;
		height: 96px;
		border-bottom: 1px solid var(--border);
		background-color: var(--bg-soft);
		background-image: repeating-linear-gradient(
			90deg,
			transparent 0 34px,
			rgba(0, 224, 122, 0.05) 34px 68px
		);
		font-size: 2rem;
		filter: grayscale(0.3);
	}

	.card:hover .card-strip {
		filter: grayscale(0);
	}

	.card-cover {
		width: 100%;
		height: 190px;
		object-fit: cover;
		border-bottom: 1px solid var(--border);
	}

	.card-title a::after {
		content: '';
		position: absolute;
		inset: 0;
	}

	.card-meta {
		position: relative;
		z-index: 1;
	}

	.feature .card-strip {
		height: 150px;
		font-size: 3rem;
	}

	.feature .card-title {
		font-size: clamp(1.7rem, 3vw, 2.3rem);
	}

	@media (min-width: 720px) {
		.feature {
			grid-column: span 2;
		}
	}
</style>
